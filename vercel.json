{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sp-college-approval-hub.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://sp-college-approval-hub.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
