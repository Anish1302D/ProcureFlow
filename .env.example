# ProcureFlow Frontend Environment Configuration Example
# Copy to .env or .env.local to customize local frontend behavior.

# Browser-Local AI Smart Check (default: false or missing)
# Set to 'true' to display the optional "Run Local AI Check" writing assistant in request forms.
# When true, runs 100% locally in-browser via WebGPU/WebAssembly with zero external API calls.
# When false or omitted, only authoritative deterministic validation is active.
VITE_LOCAL_AI_ENABLED=true
