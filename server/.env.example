# Copy to .env and fill in. Never commit .env.

PORT=4000

# Must connect as app_user. The API refuses to start as postgres or any role
# that bypasses Row-Level Security. Give app_user a password first:
#   ALTER ROLE app_user LOGIN PASSWORD '...';
#
# PORT: 5433 is what db/docker-compose.yml publishes, chosen so it cannot
# clash with a PostgreSQL already installed on the machine. If you are using
# an installed PostgreSQL rather than the container, it listens on 5432 —
# change the port in BOTH this URL and TEST_ADMIN_URL below, or the API and
# the tests will report a connection refusal.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5433/spc_approval

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Seals recorded approvals. Keep it stable: changing it makes every existing
# seal report MISMATCH. Keep it separate from JWT_SECRET.
SIGNING_SECRET=

# Where attachments are written when Google Drive is NOT configured.
# Back this up together with the database if used.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Google Drive storage backend (recommended for production on Render/cloud hosts
# where the local filesystem is ephemeral and files vanish on restart).
# Set BOTH variables to activate Drive; omit both for local-disk storage.
#
# Step-by-step setup: see docs/GOOGLE_DRIVE_SETUP.md
#
# GDRIVE_CREDENTIALS = base64-encoded service account JSON key.
#   Generate:  base64 -w0 my-service-account-key.json   (Linux/macOS)
#              [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))  (Windows PowerShell)
# GDRIVE_FOLDER_ID = the ID from the Drive folder URL:
#   https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GDRIVE_CREDENTIALS=
GDRIVE_FOLDER_ID=

# The frontend's origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000

# ── Accounts: invitations, password resets, 2-step verification ────────────
# Set to production on the live server: it makes APP_URL and
# MFA_ENCRYPTION_KEY mandatory and refuses MAIL_TRANSPORT=outbox.
NODE_ENV=
# The address people open the app at. Every emailed link (requests, issues,
# invitations, password resets, email confirmations) starts with it.
# Must be https in production; never falls back to localhost in production.
# FRONTEND_URL or APP_URL can be used (FRONTEND_URL takes precedence if both set).
FRONTEND_URL=
APP_URL=http://localhost:3000
# Time zone for dates written in emails.
APP_TIMEZONE=Asia/Kolkata
# Encrypts authenticator secrets; 32 bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable and back it up with the database: changing it makes every
# enrolled authenticator stop working (they can be reset with
# scripts/admin-recovery.js).
MFA_ENCRYPTION_KEY=
# Password hashing cost (10–15). 12 is a good default.
BCRYPT_ROUNDS=12

# ── Email delivery ──────────────────────────────────────────────────────────
# The sender name people see. Empty = the institution name from Settings.
MAIL_FROM_NAME=
# "auto" sends through Brevo, Resend or SMTP below. "outbox" writes each email
# to MAIL_OUTBOX_DIR instead of sending — development only.
MAIL_TRANSPORT=auto
MAIL_OUTBOX_DIR=mail-outbox

# Tests only: a superuser connection used to build the throwaway test database.
TEST_ADMIN_URL=postgresql://postgres:devpass@localhost:5433/postgres

# SMTP (e.g. the college server's cPanel mail account). There is no default
# host: set the one you send through. For Gmail, use an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Override principal email destination for notifications.
# In production, the system automatically resolves the active Principal from the database.
PRINCIPAL_EMAIL=

# Resend HTTP API (optional: for cloud hosts that block SMTP). RESEND_FROM must
# be an address on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM=

# Brevo HTTP API (optional alternative)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
