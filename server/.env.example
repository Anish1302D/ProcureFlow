# Copy to .env and fill in. Never commit .env.

PORT=4000

# Must connect as app_user. The API refuses to start as postgres or any role
# that bypasses Row-Level Security. Give app_user a password first:
#   ALTER ROLE app_user LOGIN PASSWORD '...';
#
# PORT: 5433 is what db/docker-compose.yml publishes, chosen so it cannot
# clash with a PostgreSQL already installed on the machine. If you are using
# an installed PostgreSQL rather than the container, it listens on 5432 —
# change the port in BOTH this URL and TEST_ADMIN_URL below, or the API and
# the tests will report a connection refusal.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5433/spc_approval

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Seals recorded approvals. Keep it stable: changing it makes every existing
# seal report MISMATCH. Keep it separate from JWT_SECRET.
SIGNING_SECRET=

# Where attachments are written when Google Drive is NOT configured.
# Back this up together with the database if used.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Google Drive storage backend (recommended for production on Render/cloud hosts
# where the local filesystem is ephemeral and files vanish on restart).
# Set BOTH variables to activate Drive; omit both for local-disk storage.
#
# Step-by-step setup: see docs/GOOGLE_DRIVE_SETUP.md
#
# GDRIVE_CREDENTIALS = base64-encoded service account JSON key.
#   Generate:  base64 -w0 my-service-account-key.json   (Linux/macOS)
#              [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))  (Windows PowerShell)
# GDRIVE_FOLDER_ID = the ID from the Drive folder URL:
#   https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GDRIVE_CREDENTIALS=
GDRIVE_FOLDER_ID=

# The frontend's origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000

# Tests only: a superuser connection used to build the throwaway test database.
TEST_ADMIN_URL=postgresql://postgres:devpass@localhost:5433/postgres

# SMTP email notifications. For Gmail, enable "App Passwords" on your Google
# account and use that 16-character password — not your regular login password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SP College Workflow <your-email@gmail.com>"

# Where issue-raised emails are sent. In production, the system looks up the
# Principal's actual email from the database; this override is for demos.
PRINCIPAL_EMAIL=protonedge01@gmail.com

# Resend HTTP API (used on Render where outbound SMTP ports 465/587 are blocked)
# Get a free key at https://resend.com
RESEND_API_KEY=
RESEND_FROM="SP College Workflow <onboarding@resend.dev>"
